SERVICE_NAME=janus

# Application Configuration
APP_ENV=local
APP_MODE=debug
APP_HOST=localhost
APP_PORT=8083
APP_KEY=
SHORT_LINK_BASE_URL=https://janus.me/
FALLBACK_BASE_URL=https://myproject.com/
API_QUOTA=10

# Link API Configuration
LINK_API_KEY=secret-api-key

# Link Buffer Configuration (Optional - for async processing)
# Set LINK_BUFFER_ENABLED=true to enable async processing
# WARNING: memory buffer may lose data on crash. Use kafka for production.
LINK_BUFFER_ENABLED=false
LINK_BUFFER_TYPE=memory              # memory or kafka
LINK_BUFFER_SIZE=1000                # Only for memory type
LINK_BUFFER_WORKERS=10
LINK_BUFFER_SHUTDOWN_TIMEOUT=10

# Kafka Configuration (Only if LINK_BUFFER_TYPE=kafka)
# KAFKA_BROKERS=localhost:9092
# KAFKA_TOPIC=link-inserts

# MongoDB Configuration
MONGO_URI=mongodb://admin:admin@mongodb:27017/
MONGO_DB=link
MONGO_USERNAME=admin
MONGO_PASSWORD=admin
MONGO_CONNECT_TIMEOUT=30
MONGO_MAX_IDLE_TIME=180
MONGO_MIN_POOL_SIZE=5
MONGO_MAX_POOL_SIZE=10
MONGO_MAX_CONNECTING=10

# Redis Configuration
REDIS_ADDR=redis:6379
REDIS_HOST=redis:6379
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MIN_IDLE_CONNS=5
REDIS_POOL_SIZE=10
REDIS_POOL_TIMEOUT=30

# Logging Configuration
LOG_LOGGER=zap
LOG_LEVEL=debug
LOG_FILE_PATH=logs

# Syslog Configuration
SYSLOG_NETWORK=udp
SYSLOG_RADDR=localhost:514

# Graylog Configuration
GRAYLOG_FACILITY=local0
GRAYLOG_PROTOCOL=udp
GRAYLOG_RADDR=localhost:12201

# Sentry Configuration
SENTRY_DSN=
SENTRY_ENVIRONMENT=develop

# Swagger Configuration
SWAGGER_URL=localhost:8083
